---
import { type Icon as IconType } from "@lucide/astro";

interface Props {
  title: string;
  href: string;
  icon: typeof IconType;
  isActive?: boolean;
}

const { title, href, icon: Icon, isActive = false } = Astro.props;
---

<div class="nav-link flex items-center gap-3">
  <Icon size={24} class={"text-primary"} />

  <a
    href={href}
    class={`text-sm font-semibold capitalize transition-all duration-300 ease-in hover:text-primary tall:text-base ${
      isActive ? "text-primary" : "text-semiblack"
    }`}
  >
    {title}
  </a>
</div>
