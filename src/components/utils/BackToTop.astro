<div id="progress" class="z-99">
  <span id="progress-value">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="h-6 w-6 text-semiblack"
      aria-hidden="true"
    >
      <path
        d="M12 19V5m0 0l-6 6m6-6l6 6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</div>

<script>
  let calcScrollValue = () => {
    let scrollProgress = document.getElementById("progress");
    let pos = document.documentElement.scrollTop;
    let calcHeight =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    let scrollValue = Math.round((pos * 101) / calcHeight);

    if (!scrollProgress) return;

    if (pos > 100) {
      scrollProgress.style.display = "grid";
      setTimeout(() => {
        scrollProgress.style.opacity = "1";
      }, 10);
    } else {
      scrollProgress.style.opacity = "0";
      setTimeout(() => {
        if (scrollProgress.style.opacity == "0") {
          scrollProgress.style.display = "none";
        }
      }, 500);
    }

    scrollProgress.addEventListener("click", () => {
      document.documentElement.scrollTop = 0;
    });

    scrollProgress.style.background = `conic-gradient(#e22f24 ${scrollValue}%, #d7d7d7 ${scrollValue}%)`;
  };

  let prevScrollpos = globalThis.scrollY;

  globalThis.onscroll = function () {
    calcScrollValue();
    //   hideNav();
  };

  globalThis.onload = calcScrollValue;
</script>

<style>
  #progress {
    position: fixed;
    bottom: 24px;
    right: 24px;
    height: 56px;
    width: 56px;
    display: none;
    place-items: center;
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  #progress-value {
    display: grid;
    height: calc(100% - 12px);
    width: calc(100% - 12px);
    background-color: #ffffff;
    border-radius: 50%;
    place-items: center;
    font-size: 35px;
    color: var(--semi-black);
  }
</style>
