---
interface Props {
  title: string;
  value: number;
}

const { title, value } = Astro.props;
---

<div class="flex flex-col gap-2">
  <div class="flex justify-between font-semibold">
    <p>{title}</p>
    <p>{Math.round(value)}%</p>
  </div>
  <div class="progress progress-striped active min-h-4 rounded-full">
    <div
      class="progress-bar min-h-4 rounded-full"
      style={`width: ${Math.round(value)}%`}
    >
    </div>
  </div>
</div>

<style>
  .progress {
    background-color: var(--color-cinza);
    border-radius: 4px;
    box-shadow: none;
  }

  .progress-bar {
    background-color: var(--primary);
    box-shadow: none;
  }

  .progress.active .progress-bar,
  .progress-bar.active {
    animation: progress-bar-stripes 2s linear infinite;
  }

  .progress-striped .progress-bar,
  .progress-bar-striped {
    background-image: linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.3) 12.5%,
      transparent 12.5%,
      transparent 25%,
      rgba(255, 255, 255, 0.3) 25%,
      rgba(255, 255, 255, 0.3) 37.5%,
      transparent 37.5%,
      transparent 50%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0.3) 62.5%,
      transparent 62.5%,
      transparent 75%,
      rgba(255, 255, 255, 0.3) 75%,
      rgba(255, 255, 255, 0.3) 87.5%,
      transparent 87.5%,
      transparent
    );
    background-size: 40px 40px;
  }

  @keyframes progress-bar-stripes {
    from {
      background-position: 40px 0;
    }
    to {
      background-position: 0 0;
    }
  }
</style>
