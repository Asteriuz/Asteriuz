---
interface Props {
  firstWord: string;
  lastWord: string;
  bgWord: string;
}

const { firstWord, lastWord, bgWord } = Astro.props;
---

<h2 class="relative mb-10 text-4xl xl:mb-16">
  <p class="relative z-10 font-heading font-bold uppercase text-semiblack">
    {firstWord} <span class="text-primary">{lastWord}</span>
  </p>
  <span class="absolute left-1/2 top-1/2 z-0 -translate-x-1/2 -translate-y-1/2 font-heading text-[72px] font-bold uppercase tracking-wide opacity-[0.07] xl:text-[85px] xl:opacity-5">
    {bgWord}
  </span>
</h2>
