---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="w-full rounded-lg p-5 shadow-float duration-300 ease-in xl:p-6">
  <div class="flex h-full flex-col gap-x-4 gap-y-8">
    <div class="flex h-full flex-col gap-6">
      <div class="flex flex-col gap-1">
        <h3 class="text-xl font-semibold">{title}</h3>
        <div class="divider"></div>
      </div>
      <slot />
    </div>
  </div>
</div>
