---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  image: ImageMetadata;
  title: string;
  description: string;
  link: string;
}

const { image, title, description, link } = Astro.props;
---

<div
  class="group w-full rounded-lg shadow-float duration-300 ease-in hover:-translate-y-3"
>
  <div class="flex h-full flex-col gap-x-4 gap-y-8">
    <div class="flex h-full flex-col gap-6">
      <div class="flex flex-col gap-4">
        <a
          href={link}
          target="_blank"
          class="block h-70 w-full px-5 pt-5 duration-300 ease-in group-hover:p-0"
        >
          <Image
            class="h-full w-full object-cover rounded-lg duration-300 ease-in group-hover:rounded-none group-hover:rounded-t-lg"
            src={image}
            alt={title}
          />
        </a>

        <div class="flex flex-col gap-2 px-5 pb-5">
          <h3 class="text-xl font-semibold">{title}</h3>
          <p class="text-cinza-text">{description}</p>
        </div>
      </div>
    </div>
  </div>
</div>