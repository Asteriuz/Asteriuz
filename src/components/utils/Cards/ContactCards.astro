---
import { type Icon as IconType } from "@lucide/astro";

interface Props {
  title: string;
  subtitle: string;
  icon: typeof IconType;
  link: string;
}

const { title, subtitle, icon: Icon, link } = Astro.props;
---

<div
  class="w-full rounded-lg p-6 shadow-float duration-300 ease-in hover:-translate-y-1 xl:p-8"
>
  <div class="flex flex-col items-center gap-x-4 gap-y-5">
    <a
      aria-label={title}
      href={link}
      class="flex h-20 w-20 items-center justify-center rounded-full bg-primary text-4xl text-white shadow-float"
    >
      <Icon size={40} />
    </a>

    <div class="flex flex-col items-center gap-2">
      <h3 class="text-xl font-semibold">{title}</h3>
      <p class="text-center text-lg text-cinza-text">
        <a
          aria-label={title}
          class="transition-colors ease-in hover:text-primary"
          href={link}
        >
          {subtitle}
        </a>
      </p>
    </div>
  </div>
</div>
