---
import About from "@/components/Home/About.astro";
import Hero from "@/components/Home/Hero.astro";
import Services from "@/components/Home/Services.astro";
import Curriculo from "@/components/Home/Curriculo.astro";
import Portfolio from "@/components/Home/Portfolio.astro";
import Contact from "@/components/Home/Contact.astro";
import RootLayout from "@/layouts/RootLayout.astro";
---

<RootLayout>
  <main class="flex flex-1 flex-col overflow-x-hidden">
    <Hero />
    <div class="px-4 xl:ml-72 xl:px-8">
      <About />
      <Services />
      <Curriculo />
      <Portfolio />
      <Contact /> 
    </div>
  </main>
</RootLayout>

